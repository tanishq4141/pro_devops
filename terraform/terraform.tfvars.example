# Copy to terraform.tfvars and adjust. NEVER put AWS keys in this file -
# Terraform reads credentials from `aws configure` / environment variables.
aws_region          = "ap-south-1"
environment         = "dev"
cluster_name        = "stockpilot-eks"
cluster_version     = "1.31"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 3
